# Obligatoire en production : longue chaîne aléatoire, par exemple
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=False

# Nom(s) de domaine servis, séparés par des virgules (sert aussi aux origines CSRF en https).
ALLOWED_HOSTS=ton-domaine.fr

# Premier administrateur, créé par une migration lors du premier démarrage (base neuve).
# Les variables doivent donc être renseignées avant ce premier démarrage.
# À retirer du fichier une fois le compte créé.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Facultatif : port local publié pour nginx (défaut 8000), tag d'image (défaut latest).
# APP_PORT=8000
# IMAGE_TAG=latest

# Facultatif : autre base que le SQLite du volume (ex. PostgreSQL).
# DATABASE_URL=postgres://user:password@host:5432/dbname
